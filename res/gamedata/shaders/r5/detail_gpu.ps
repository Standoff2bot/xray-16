#include "common.h"
#include "sload.h"

// Input from vertex shader (matches lod_gpu.vs output)
struct v2p
{
	float2	tc		: TEXCOORD0;	// Texture coordinates
	float4	position: TEXCOORD1;	// View position + hemi
	float3	N		: TEXCOORD2;	// View-space normal
};

f_deffer main(v2p I)
{
	// Sample base texture
	float4 base_color = s_base.Sample(smp_base, I.tc);

	// Alpha test
	clip(base_color.w - def_aref);

	// Extract hemi from position.w
	float h = I.position.w;
	float ms = xmaterial; // Material ID

	// Normalize normal
	float3 norm = normalize(I.N);

	// Pack using standard gbuffer packer
	// norm: normal + hemi
	// pos: position + material
	// col: albedo + gloss
	f_deffer O = pack_gbuffer(
		float4(norm, h),
		float4(I.position.xyz + norm * def_virtualh / 2.0, ms),
		float4(base_color.rgb, def_gloss)
	);

	return O;
}
