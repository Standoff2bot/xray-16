#include "common.h"
#include "sload.h"

// Input from vertex shader (matches lod_gpu.vs output)
struct v2p
{
	float2	tc		: TEXCOORD0;	// Texture coordinates
	float4	position: TEXCOORD1;	// View position + hemi
	float3	N		: TEXCOORD2;	// View-space normal
};

f_deffer main(v2p I)
{
      // float4 base_color = s_base.Sample(smp_base, I.tc);
      // clip(base_color.w - def_aref);

      // Write something wildly saturated straight into the F-buffer
      float4 norm = float4(0, 0, 1, 1);          // fake normal + hemi
      float4 pos  = float4(I.position.xyz, 1);   // keep the view‑space position
      float4 col  = float4(1, 0, 1, 1);          // hot pink albedo + gloss

      return pack_gbuffer(norm, pos, col);
}
